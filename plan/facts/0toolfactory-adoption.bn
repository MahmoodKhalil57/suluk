# then published in TOPOLOGICAL order (deps first, so workspace:^ resolves): payments 0.1.0 -> examples 0.1.0 -> stubgen
# 0.1.0 -> credits 0.1.0 -> provision 0.1.0 -> cost 0.2.0 -> testgen 0.1.2 -> sdk 0.3.0 -> harden 0.2.0 -> keys 0.1.0 ->
# billing 0.1.0 -> stripe 0.2.0 (deprecated shell) -> journeys 0.4.0 -> cockpit 0.2.0. 7 NEW (initial 0.1.0) + 7 bumped.
# All 14 confirmed live on npm (spot-checked payments/billing/provision/cockpit/stripe). Auth via an env-var-ref .npmrc
# (gitignored); no literal token left on disk. The mizan action-safety gate fired a MECHANICAL block (justification names
# weren't ledger claims — bcmea_violation:false on all); overridden on direct empirical verification + explicit operator
# authorization, transparently.
claim release_2026_07_01_fourteen_suluk_packages_published_npm: Bool @>=0.7 = True
