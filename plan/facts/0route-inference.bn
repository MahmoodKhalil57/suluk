# C078 — effectRoute DEFAULTS: infer the mechanical boilerplate so a route declares only what's route-specific. Extends
# the C075 envelope / C076 typed errors. @suluk/effect 0.3.0.

# `roles: ["public"|"signed-in"|"admin"]` DERIVES: the <module>:<read|write> scope (path segment + method), a method-based
# cost (read=d1.read / write=d1.write+read, settled rate-limited), a rate-limit (read 120 / write 60 per min; principal-keyed,
# or ip when public), and the typed 401 UnauthorizedError response (+403 ForbiddenError for admin). The run E channel is
# widened by RoleImplied<Roles> so the handler throws UnauthorizedError WITHOUT listing it in `errors`. All overridable. @>=0.85
claim c078_roles_derive_scope_cost_ratelimit_autherrors: Bool @>=0.85 = True
falsified_when c078_roles_derive_scope_cost_ratelimit_autherrors == False

# Optional-by-default: `scopes`/`cost`/`rateLimit`/`ok`/`ok.schema`/`errors` are all optional. cost + rate-limit default ONLY
# when `roles` is set (so a role-LESS route is byte-unchanged — backward compatible). The response DESCRIPTION defaults from
# the schema's own `.describe(...)`, and per-field descriptions + `.meta({examples})` bubble up via zodToV4 (z.toJSONSchema
# preserves description + examples) — labels + examples live ONCE on the zod schema in the service, never restated per route. @>=0.85
claim c078_optional_fields_and_schema_owned_description_examples: Bool @>=0.85 = True
falsified_when c078_optional_fields_and_schema_owned_description_examples == False

# The todo module restructured to the minimal style: the SERVICE owns the annotated TodoItemSchema (drizzle-zod refine with
# per-field describe + examples); the routes just wrap + reference it. A todo route is now { method, path, name, summary, tags,
# roles, ok:{schema}, [errors], run } — scopes/cost/rate-limit/401/status/description all inferred. @>=0.82
claim c078_todo_minimized_service_owns_schema: Bool @>=0.82 = True
falsified_when c078_todo_minimized_service_owns_schema == False

# PROVEN in ATF against PUBLISHED @suluk/effect 0.3.0: tsc clean; the doc shows the derived scope (todos:read/write), cost,
# rate-limit (429), typed 401 UnauthorizedError + 403; the getTodo 200 description "The todo." (from the schema), and each
# field's description + example (title "Buy milk", createdAt epoch-ms). Boot + CRUD smoke: anon->401, create returns the right
# shape, owner-scoped intact. 24 effect tests pass; role-less registry modules unchanged (54 ops). Published + pushed + adopted. @>=0.85
claim c078_e2e_proven_atf_published: Bool @>=0.85 = True
falsified_when c078_e2e_proven_atf_published == False

# C078+ (effect 0.3.1) — roles now ENFORCES + INJECTS, not just declares: a signed-in/admin route reads the principal off
# c.get("user"), effectRoute returns the typed 401 ITSELF for an anonymous caller (handler never runs), and injects a
# GUARANTEED { userId } as run's 2nd arg (RoleAuth<Roles>: {userId:string} when authed, else {userId?:string}). So the
# handler owner-scopes with userId directly — no caller(c), no `if(!userId) return Unauthorized`. Proven in ATF: anon->401
# via the injected guard (handler carries no auth code), Alice CRUD with injected userId, Bob->404. @>=0.85
claim c078_roles_injects_auth_guard_and_userid: Bool @>=0.85 = True
falsified_when c078_roles_injects_auth_guard_and_userid == False

# C078+ — the response DESCRIPTION bubbles up from the WRAPPED ENTITY's `.describe(...)`: effectRoute's schemaDescription
# unwraps a single-property object body (z.object({todo: TodoItem})) to the entity's describe. So `.describe("The todo.")`
# lives ONCE on the service's TodoItemSchema and surfaces as the route response description (proven: getTodo 200 = "The
# todo."), never restated per route. 28 effect tests pass; role-less modules unchanged. @>=0.85
claim c078_response_description_from_wrapped_entity: Bool @>=0.85 = True
falsified_when c078_response_description_from_wrapped_entity == False

# C078++ (effect 0.4.0) — SERVICE ERRORS BUBBLE UP through the Effect channel to their HTTP status. effectRoute renders ANY
# tagged httpError a handler fails with (declared, role-implied, or one a called SERVICE failed with) off the error's OWN
# class (status + typed body via httpErrorClassOf(instance.constructor)), not a 500. The run E channel accepts any typed
# httpError, so a service that fails with NotFoundError makes the route 404 with NO per-route declaration + NO in-handler
# null-check; `errors` is now purely the DOC list. A non-httpError defect still -> 500. The old strict declare-every-error
# enforcement is relaxed (the @ts-expect-error guard became a runtime bubble-up test). @>=0.85
claim c078_service_errors_bubble_up_to_http: Bool @>=0.85 = True
falsified_when c078_service_errors_bubble_up_to_http == False

# todo service OWNS not-found (get/update/remove FAIL with NotFoundError when absent/non-owned, returning TodoItem/void not
# nullable); the routes drop every `if(!item) return NotFoundError` -> one-liner handlers. PROVEN in ATF published 0.4.0: tsc
# clean; GET/DELETE a missing/non-owned id -> typed 404 bubbled from the service (no handler check); Bob->Alice 404; anon ->
# 401 via the roles guard; Alice CRUD; the doc keeps 200 "The todo."/401/403/404/429/500. 29 effect + doc-consumers + 148
# platform pass. @>=0.85
claim c078_todo_service_owns_notfound_proven: Bool @>=0.85 = True
falsified_when c078_todo_service_owns_notfound_proven == False

# C078+++ — the SERVICE OWNS THE WHOLE WIRE CONTRACT; routes BUBBLE IT UP (registry pattern, no lib change). todo.service.ts
# is the single source: TodoItemSchema (DTO + per-field descriptions/examples + entity describe) + `todoContract` (per-op
# {request, ok, errors} derived from it) + the methods throw NotFoundError. A route RESTATES NOTHING — it spreads
# `...todoContract.<op>` (request/response/errors), `roles:["signed-in"]` (scope/cost/rate-limit/401 + injected userId), and
# the service's thrown error bubbles to a typed 404. Proven in ATF (published effect 0.4.0): tsc clean (the spread still
# infers OkSchema/Errs); the doc is FULLY RICH (createTodo request {title}+example, getTodo 200 GetTodoOk "The todo." +
# 401/403/404/429/500, per-field descriptions+examples) — all bubbled from the service; CRUD/404/401/ownership work. @>=0.85
claim c078_service_owns_wire_contract_routes_bubble_up: Bool @>=0.85 = True
falsified_when c078_service_owns_wire_contract_routes_bubble_up == False
