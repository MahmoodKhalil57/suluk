# C078 — effectRoute DEFAULTS: infer the mechanical boilerplate so a route declares only what's route-specific. Extends
# the C075 envelope / C076 typed errors. @suluk/effect 0.3.0.

# `roles: ["public"|"signed-in"|"admin"]` DERIVES: the <module>:<read|write> scope (path segment + method), a method-based
# cost (read=d1.read / write=d1.write+read, settled rate-limited), a rate-limit (read 120 / write 60 per min; principal-keyed,
# or ip when public), and the typed 401 UnauthorizedError response (+403 ForbiddenError for admin). The run E channel is
# widened by RoleImplied<Roles> so the handler throws UnauthorizedError WITHOUT listing it in `errors`. All overridable. @>=0.85
claim c078_roles_derive_scope_cost_ratelimit_autherrors: Bool @>=0.85 = True
falsified_when c078_roles_derive_scope_cost_ratelimit_autherrors == False

# Optional-by-default: `scopes`/`cost`/`rateLimit`/`ok`/`ok.schema`/`errors` are all optional. cost + rate-limit default ONLY
# when `roles` is set (so a role-LESS route is byte-unchanged — backward compatible). The response DESCRIPTION defaults from
# the schema's own `.describe(...)`, and per-field descriptions + `.meta({examples})` bubble up via zodToV4 (z.toJSONSchema
# preserves description + examples) — labels + examples live ONCE on the zod schema in the service, never restated per route. @>=0.85
claim c078_optional_fields_and_schema_owned_description_examples: Bool @>=0.85 = True
falsified_when c078_optional_fields_and_schema_owned_description_examples == False

# The todo module restructured to the minimal style: the SERVICE owns the annotated TodoItemSchema (drizzle-zod refine with
# per-field describe + examples); the routes just wrap + reference it. A todo route is now { method, path, name, summary, tags,
# roles, ok:{schema}, [errors], run } — scopes/cost/rate-limit/401/status/description all inferred. @>=0.82
claim c078_todo_minimized_service_owns_schema: Bool @>=0.82 = True
falsified_when c078_todo_minimized_service_owns_schema == False

# PROVEN in ATF against PUBLISHED @suluk/effect 0.3.0: tsc clean; the doc shows the derived scope (todos:read/write), cost,
# rate-limit (429), typed 401 UnauthorizedError + 403; the getTodo 200 description "The todo." (from the schema), and each
# field's description + example (title "Buy milk", createdAt epoch-ms). Boot + CRUD smoke: anon->401, create returns the right
# shape, owner-scoped intact. 24 effect tests pass; role-less registry modules unchanged (54 ops). Published + pushed + adopted. @>=0.85
claim c078_e2e_proven_atf_published: Bool @>=0.85 = True
falsified_when c078_e2e_proven_atf_published == False
