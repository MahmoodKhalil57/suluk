# C117 -- operator: "cleanup the entire surface area of registry/services/todo such that the code is pragmatic
# and declaritive and self documenting and we can remove all manullay written typescript types and then remove
# all comments since function names should be intuitive enough and everything should be statically connected with
# typescript and can build a comprehensive detailed suluk openapiv4 document that we can even build BDD tests
# using primitives generated from it." ADR C117. @>=0.85
claim c117_todo_declarative_cleanup_no_types_no_comments: Bool @>=0.85 = True
falsified_when c117_todo_declarative_cleanup_no_types_no_comments == False

# APPLIED "define once, derive everywhere" to the TYPE level: removed dead type aliases (TodoRow/TodoItem/
# TodoItemSchema -- grepped the whole registry/ tree, confirmed referenced only in their own file's comments,
# never actually imported anywhere); removed hand-written inline object types where TS already infers them
# contextually (verified empirically via a throwaway compile check that body:X + run:(ctx,body)=>... in the SAME
# sulukFn call infers body's type with zero annotation, no prior precedent existed in this codebase for this);
# replaced a hand-written duplicate shape (patchTodo's inline {title?,completed?}) with z.infer<typeof UpdateReq>;
# kept genuinely necessary seed points (createTodo's z.infer<typeof CreateReq>, id:string for by-id ops) since
# they derive from or are the sole source of a type, not duplicates; switched readCost/writeCost/deleteCost
# (CostModel) and todoProvision (InstanceSpec[]) from `: Type` to `satisfies Type` -- verified empirically that
# dropping the annotation ENTIRELY silently widens string-literal fields (settlement.method -> string), breaking
# assignability, so satisfies (not bare inference) is the correct idiom, not a regression risk. @>=0.9
claim c117_type_removal_verified_empirically_not_guessed: Bool @>=0.9 = True
falsified_when c117_type_removal_verified_empirically_not_guessed == False

# REAL ARCHITECTURAL IMPROVEMENT: extracted listTodos's hand-rolled try/catch (added in C116 to fix a real bug)
# into @suluk/drizzle's new resolveListQuery(table,raw,scope,defaultOrderBy,opts?) -- closes the C116-flagged risk
# ("any other model built the same way" could have the same bug) at the source: the safe, bug-fixed chain now
# lives in ONE reusable place. @>=0.9
claim c117_resolvelistquery_extracted_closes_c116_flagged_risk: Bool @>=0.9 = True
falsified_when c117_resolvelistquery_extracted_closes_c116_flagged_risk == False

# VERIFIED (not assumed) the OpenAPI + BDD generation goal: emitV4(todoOps) produces a document with full
# page/perPage/sort/order/q/filter query schema, column descriptions/examples, cost/ratelimit/scenario facets on
# every op; @suluk/journeys's renderScenarioOutlines(document) produces real, readable Gherkin covering all 6
# operations (incl. negative-Then scenarios per 404 path) directly off the (now comment-free) step fields -- zero
# hand-authored test scaffolding. @>=0.9
claim c117_openapi_and_bdd_generation_verified_live: Bool @>=0.9 = True
falsified_when c117_openapi_and_bdd_generation_verified_live == False

# An 8-agent-equivalent (4-reviewer) INDEPENDENT adversarial verification pass (cleanup-completeness,
# behavior-parity, doc-completeness, security-adversary -- each building their OWN throwaway harness) surfaced 3
# REAL, pre-existing bugs (not introduced by the comment/type removal itself; exposed by resolveListQuery's
# extraction + by the doc-completeness reviewer actually inspecting the emitted document, not trusting prior
# claims). @>=0.9
claim c117_adversarial_pass_found_three_real_bugs: Bool @>=0.9 = True
falsified_when c117_adversarial_pass_found_three_real_bugs == False

# BUG 1 CONFIRMED + FIXED: sulukFmt's mergeSlices treated `ok` as ONE ATOMIC value (inherit(own.ok,deps,...)) --
# createTodo's controller declaring only ok:{status:201} (deliberately, to avoid restating the model's ok.schema)
# won OUTRIGHT and ERASED the dependency's full response schema. Reproduced directly: the actual emitted
# CreateTodoOk component was {properties:{todo:{}}} -- confirmed via git-stash-isolated repro against the TRUE
# pre-fix code (a first repro attempt gave a false negative due to a cwd mistake in git stash, caught + corrected
# before drawing any conclusion). The pre-existing unit test covering this exact route only checked outer
# properties KEY NAMES (["item"]), never the nested content -- too shallow, hence unnoticed. Fix: mergeOk merges
# status/schema/description independently (own wins per-field), mirroring mergeStore's existing shape. Weak test
# strengthened + 3 new tests added. @suluk/effect 0.14.1 -> 0.14.2. @>=0.9
claim c117_bug1_mergeok_atomic_merge_fixed_verified: Bool @>=0.9 = True
falsified_when c117_bug1_mergeok_atomic_merge_fixed_verified == False

# BUG 2 CONFIRMED + FIXED: an advanced filter= tree with ~1000+ sibling/nested boolean conditions is 100%
# schema-valid + dataType-valid (resolveListQuery's own try/catch never fires) but SQLite/D1 reject the compiled
# expression at EXECUTION time ("Expression tree is too large, maximum depth 1000") -- an unhandled 500 from
# ordinary read traffic, entirely outside resolveListQuery's boundary (happens inside the model's own db.select()
# await). Not a cross-user leak, but a real, deterministic, attacker-triggerable crash. Fix: filterNodeSchema now
# rejects a tree past opts.maxFilterNodes (default 200, safe margin under SQLite's limit) via .refine() at
# VALIDATION time -- already inside every caller's existing try/catch, no new catch site needed. Verified: the
# exact 1000-condition DoS payload now returns 200 with a safe, owner-scoped fallback, live, via a mounted
# real-Hono-app + real-bun:sqlite harness. @suluk/drizzle 0.11.1 -> 0.12.0. @>=0.9
claim c117_bug2_sqlite_expression_depth_dos_fixed_verified: Bool @>=0.9 = True
falsified_when c117_bug2_sqlite_expression_depth_dos_fixed_verified == False

# ALSO FIXED (cheap, low-risk, same pass): listTodo route binding renamed listTodos for naming consistency
# (cosmetic, zero behavior change); filter's wire schema gained a human-readable .meta({description,examples}).
# FLAGGED NOT FIXED (real, but a genuine v4-spec-level design question, not a narrow fix): filter is not
# $defs/$ref-linked to filterNodeSchema's real recursive JSON Schema in the actual emitted document (C114's own
# ADR overclaimed this) -- closing it needs a general "string param whose content is described by a separate JSON
# Schema" mechanism (OAS3 has parameter.content; Suluk's v4 candidate doesn't yet), a foundational decision
# affecting every future feature with this shape -- surfaced for a deliberate future decision, not rushed. @>=0.85
claim c117_naming_fix_and_filter_ref_gap_flagged_honestly: Bool @>=0.85 = True
falsified_when c117_naming_fix_and_filter_ref_gap_flagged_honestly == False

# VERIFIED: full 46-package ecosystem sweep -- zero fail, zero typecheck errors. @suluk/drizzle 114/114 (9 new).
# @suluk/effect 157/157 (3 new + 1 strengthened). Re-verified end-to-end (mergeOk fix + depth-limit fix + C116
# fallback + owner-scope invariant + BDD generation, all together) via a fresh throwaway scratch harness mounting
# the REAL, unmodified todo module on a real Hono app + real bun:sqlite rows. @>=0.9
claim c117_full_sweep_and_combined_reverify_clean: Bool @>=0.9 = True
falsified_when c117_full_sweep_and_combined_reverify_clean == False
