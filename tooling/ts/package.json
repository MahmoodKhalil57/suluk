    "nanostores": "^1.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/codicon": "^1.2.63",
    "@iconify-json/vscode-icons": "^1.2.63",
    "@iconify/utils": "^3.1.3",
    "typedoc": "0.28.19",
    "typedoc-github-theme": "0.4.0",
    "typescript": "6.0.3"
