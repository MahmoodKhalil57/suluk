  "components": {
    "schemas": {
      "Catalog": {
        "type": "object",
        "properties": {
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Service"
            }
          }
        }
      },
      "Service": {
        "type": "object",
        "required": [
          "name",
          "id",
          "description",
          "bindable",
          "plans"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "syslog_drain",
                "route_forwarding",
                "volume_mount"
              ]
            }
          },
          "bindable": {
            "type": "boolean"
          },
          "metadata": {
            "$ref": "#/components/schemas/Metadata"
          },
          "dashboard_client": {
            "$ref": "#/components/schemas/DashboardClient"
          },
          "binding_rotatable": {
            "type": "boolean"
          },
          "plan_updateable": {
            "type": "boolean"
          },
          "plans": {
