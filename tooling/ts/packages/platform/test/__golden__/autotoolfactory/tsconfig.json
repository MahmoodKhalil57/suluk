{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node",
      "@cloudflare/workers-types"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "src",
    "provision.config.ts",
    "platform.config.ts"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
