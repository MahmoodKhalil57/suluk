# .env.example — the keys in the COMMITTED .env AFTER `bun run provision` (values ENCRYPTED with @suluk/env;
# SULUK_PUBLIC_KEY plaintext). The EPHEMERAL CF master token (CLOUDFLARE_API_TOKEN) is supplied in .env.temp and DELETED
# after minting — it is NOT here. Non-secret config lives in platform.config.ts `vars` (→ wrangler.toml [vars]).

SULUK_PUBLIC_KEY=        # @suluk/env public key (plaintext; can only encrypt)

# Provisioning keeper + minted scoped tokens (surface local — never shipped to the Worker; encrypted):
CLOUDFLARE_ACCOUNT_ID=        # CF account id — a KEEPER (routine scoped-token ops need it), kept encrypted in .env
CLOUDFLARE_D1_TOKEN=        # scoped: D1 Write (migrations)
CLOUDFLARE_WORKERS_TOKEN=        # scoped: Workers Scripts Write (deploy + secret put)
CLOUDFLARE_KV_TOKEN=        # scoped: KV Write (rate-limit / rate-credit namespaces)

# Runtime secrets (encrypted; reach the Worker via loadEnv / sync-secrets):
BETTER_AUTH_SECRET=        # session-signing key — AUTO-GENERATED by `bun run provision` (32 random bytes); no need to supply it
# GOOGLE_CLIENT_ID=        # optional — enables Google sign-in
# GOOGLE_CLIENT_SECRET=        # optional — pairs with GOOGLE_CLIENT_ID
STRIPE_SECRET_KEY=        # your Stripe secret key
# RESEND_API_KEY=        # omit → the console provider (dev)
STRIPE_WEBHOOK_SECRET=        # verifies inbound Stripe events (POST /api/webhooks/stripe)
# SUPERADMIN_EMAILS=        # comma/space-separated admin emails → the admin scope (secret-surfaced so they stay out of git plaintext)
