# .env.temp — PLAINTEXT bootstrap for `bun run provision`. Gitignored; consumed + DELETED after provisioning.
# Fill in the raw values, then run `bun run provision` (it encrypts the keepers into .env + deletes this file + the
# ephemeral CF master token). The DECRYPTION key is generated for you (→ ~/.suluk/settings.json + the Worker).

# Provisioning creds (used to create infra + mint scoped tokens; the master is DELETED, never committed):
CLOUDFLARE_API_TOKEN=        # CF account-scoped master token (Workers Scripts + D1 + KV Edit) — mints the scoped tokens + provisions, then DELETED (never in git)
CLOUDFLARE_ACCOUNT_ID=        # CF account id — a KEEPER (routine scoped-token ops need it), kept encrypted in .env

# Runtime secrets (encrypted into .env + committed; shipped to the Worker):
BETTER_AUTH_SECRET=        # session-signing key — `openssl rand -base64 32`
GOOGLE_CLIENT_ID=        # optional — enables Google sign-in
GOOGLE_CLIENT_SECRET=        # optional — pairs with GOOGLE_CLIENT_ID
STRIPE_SECRET_KEY=        # your Stripe secret key
RESEND_API_KEY=        # omit → the console provider (dev)
STRIPE_WEBHOOK_SECRET=        # verifies inbound Stripe events (POST /api/webhooks/stripe)
SUPERADMIN_EMAILS=        # comma/space-separated admin emails → the admin scope (secret-surfaced so they stay out of git plaintext)
