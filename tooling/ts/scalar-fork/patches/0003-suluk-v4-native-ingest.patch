@@ -0,0 +1,219 @@
+/**
+ * SULUK v4 PATCH — native OpenAPI v4 ("Moonwalk") ingestion.
+ *
+ * Scalar's engine is OpenAPI 3.x-shaped (`paths[uri][method] → Operation`). OpenAPI v4 keys operations by NAME
+ * (`pathItem.requests`), with `parameterSchema:{query,path,header,body}`, NAMED responses, and composition
+ * (`shared` / `pathResponses` / `apiResponses`). This projects a v4 document INTO Scalar's 3.x store model IN
+ * PLACE — invoked right after `upgrade()`, BEFORE `coerce(openapiSchema)` would strip the unknown `requests`
+ * key — so Scalar's existing components + try-it render it. The v4 identity is preserved for display: each
+ * request's NAME becomes the `operationId` AND the operation title (`summary` fallback), and the document still
+ * reports `4.0.0-candidate` via `x-original-oas-version` (captured from the original doc in client.ts), so the
+ * version badge reads v4 even though the internal working model is 3.1-shaped.
+ *
+ * Self-contained port of @suluk/compat's `downgrade()` mapping (kept in sync by hand). Lossy boundary: 3.1 keys
+ * operations by METHOD, so two v4 requests sharing a method on one path can't both be represented — we keep the
+ * first (multi-request-per-method is the deferred frontier).
+ */
+
+import { PATH_DISAMBIGUATOR } from '@/helpers/strip-path-disambiguator'
+
+type Obj = Record<string, unknown>
+
+const METHODS = ['get', 'put', 'post', 'delete', 'options', 'head', 'patch', 'trace']
+
+function isRef(s: unknown): s is { $ref: string } {
+  return !!s && typeof s === 'object' && typeof (s as Obj).$ref === 'string'
+}
+
+/** Expand one per-location parameterSchema (object-of-properties) into 3.1 Parameter Objects. */
+function expandParams(loc: string, schema: unknown, out: Obj[]): void {
+  if (schema == null || isRef(schema) || typeof schema === 'boolean') return
+  const s = schema as Obj
+  const props = (s.properties ?? {}) as Record<string, unknown>
+  const required = new Set((s.required as string[] | undefined) ?? [])
+  for (const [name, propSchema] of Object.entries(props)) {
+    out.push({ name, in: loc, required: loc === 'path' ? true : required.has(name), schema: propSchema })
+  }
+}
+
+/** allOf-compose one inherited (shared) location schema under one request-level location schema. */
+function mergeLoc(shared: unknown, own: unknown): unknown {
+  if (shared == null) return own
+  if (own == null) return shared
+  if (isRef(shared) || isRef(own) || typeof shared === 'boolean' || typeof own === 'boolean') return { allOf: [shared, own] }
+  const a = shared as Obj
+  const b = own as Obj
+  const props = { ...((a.properties as object) ?? {}), ...((b.properties as object) ?? {}) }
+  const required = [...new Set([...((a.required as string[]) ?? []), ...((b.required as string[]) ?? [])])]
+  const out: Obj = { type: 'object', properties: props }
+  if (required.length) out.required = required
+  return out
+}
+
+function effectiveParams(shared: Obj | undefined, own: Obj | undefined): Obj {
+  return {
+    query: mergeLoc(shared?.query, own?.query),
+    path: mergeLoc(shared?.path, own?.path),
+    header: mergeLoc(shared?.header, own?.header),
+    cookie: mergeLoc(shared?.cookie, own?.cookie),
+    body: own?.body ?? shared?.body,
+  }
+}
+
+function mediaTypes(ct: unknown, fallback: string): string[] {
+  if (ct == null) return [fallback]
+  return Array.isArray(ct) ? (ct as string[]) : [ct as string]
+}
+
+function responseEntry(resp: Obj): Obj {
+  const entry: Obj = { description: (resp.description as string) ?? '' }
+  if (resp.contentSchema != null) {
+    const content: Obj = {}
+    for (const mt of mediaTypes(resp.contentType, 'application/json')) content[mt] = { schema: resp.contentSchema }
+    entry.content = content
+  }
+  return entry
+}
+
+/** Compose responses by status: inherited (apiResponses ∪ pathResponses) overlaid by the request's own. */
+function projectResponses(own: Record<string, Obj> | undefined, inherited: Obj[]): Obj {
+  const out: Obj = {}
+  for (const resp of inherited) out[String(resp.status)] = responseEntry(resp)
+  for (const resp of Object.values(own ?? {})) out[String(resp.status)] = responseEntry(resp) // request wins
+  if (Object.keys(out).length === 0) out.default = { description: '' } // 3.1 requires ≥1 response
+  return out
+}
+
+function projectOperation(name: string, req: Obj, shared: Obj | undefined, inherited: Obj[]): Obj {
+  const op: Obj = {
+    // preserve the v4 by-name handle as the 3.1 operationId — and surface the NAME as the operation title
+    // (Scalar renders `summary`), so the v4 request identity is visible. A real request.summary wins.
+    operationId: (req.operationId as string) ?? name,
+    summary: (req.summary as string) ?? name,
+    responses: projectResponses(req.responses as Record<string, Obj> | undefined, inherited),
+  }
+  if (req.description) op.description = req.description
+  if (req.deprecated) op.deprecated = req.deprecated
+  if (req.tags) op.tags = req.tags
+  if (req.security) op.security = req.security
+  // carry vendor extensions (x-*) through — incl. x-badges / x-suluk-* facets the host stamped on each request.
+  for (const [k, v] of Object.entries(req)) if (k.startsWith('x-')) op[k] = v
+
+  const params: Obj[] = []
+  const ps = effectiveParams(shared, req.parameterSchema as Obj | undefined)
+  expandParams('path', ps.path, params)
+  expandParams('query', ps.query, params)
+  expandParams('header', ps.header, params)
+  expandParams('cookie', ps.cookie, params)
+  if (params.length) op.parameters = params
+
+  const body = (req.contentSchema ?? (req.parameterSchema as Obj | undefined)?.body) as unknown
+  if (body != null) {
+    const content: Obj = {}
+    for (const mt of mediaTypes(req.contentType, 'application/json')) content[mt] = { schema: body }
+    op.requestBody = { content }
+  }
+  return op
+}
+
+/** v4 uriTemplate → 3.1 path. Drop RFC6570 query expansion ({?a,b}); {+var} reserved-expansion → plain {var}. */
+function projectPathKey(uri: string): string {
+  const qCut = uri.search(/\{[?&]/)
+  let p = qCut >= 0 ? uri.slice(0, qCut) : uri
+  p = p.replace(/\{\+([^}]+)\}/g, '{$1}')
+  return p.startsWith('/') ? p : '/' + p
+}
+
+/**
+ * Project a v4 pathItem's requests into a method-keyed 3.x pathItem (`primary`). When two+ requests share a method
+ * on this path (v4 multi-request-per-method), the first wins the real path-key slot and the rest are returned as
+ * `extras` — the caller registers each under a synthetic path key so all render as DISTINCT operations.
+ */
+function projectPathItem(pi: Obj, apiResponses: Obj[]): { primary: Obj; extras: Array<{ name: string; method: string; op: Obj }> } {
+  const out: Obj = {}
+  if (pi.summary) out.summary = pi.summary
+  if (pi.description) out.description = pi.description
+  if (pi.servers) out.servers = pi.servers
+  const inherited = [...apiResponses, ...Object.values((pi.pathResponses as Record<string, Obj>) ?? {})]
+  const shared = (pi.shared as Obj | undefined)?.parameterSchema as Obj | undefined
+  const seen = new Set<string>()
+  const extras: Array<{ name: string; method: string; op: Obj }> = []
+  for (const [name, reqRaw] of Object.entries((pi.requests as Record<string, Obj>) ?? {})) {
+    const req = reqRaw as Obj
+    const method = String(req.method ?? '').toLowerCase()
+    if (!METHODS.includes(method)) continue
+    const op = projectOperation(name, req, shared, inherited)
+    if (seen.has(method)) {
+      extras.push({ name, method, op }) // v4 multi-request sibling → synthetic path key (registered by caller)
+    } else {
+      seen.add(method)
+      out[method] = op
+    }
+  }
+  return { primary: out, extras }
+}
+
+/**
+ * Mutate a (possibly v4) document in place into Scalar's 3.x store shape. No-op when it isn't a v4 document, so
+ * it is safe to call unconditionally on every ingested doc.
+ */
+export function projectV4ToStore(doc: unknown): void {
+  if (!doc || typeof doc !== 'object') return
+  const d = doc as Obj
+  const paths = (d.paths as Record<string, Obj>) ?? {}
+  const looksV4 =
+    String(d.openapi ?? '').startsWith('4') ||
+    Object.values(paths).some((pi) => pi && typeof pi === 'object' && 'requests' in (pi as Obj))
+  if (!looksV4) return
+
+  // tags: v4 keys tags by NAME (object) → 3.1 array of {name,...}
+  if (d.tags && typeof d.tags === 'object' && !Array.isArray(d.tags)) {
+    d.tags = Object.entries(d.tags as Obj).map(([name, t]) => ({ name, ...(t as object) }))
+  }
+
+  const apiResponses =
+    d.apiResponses && typeof d.apiResponses === 'object' ? (Object.values(d.apiResponses as Obj) as Obj[]) : []
+
+  if (d.paths && typeof d.paths === 'object') {
+    const newPaths: Obj = {}
+    for (const [uri, piRaw] of Object.entries(d.paths as Obj)) {
+      const pi = piRaw as Obj
+      if (pi && typeof pi === 'object' && pi.requests && typeof pi.requests === 'object') {
+        const realKey = projectPathKey(uri)
+        const { primary, extras } = projectPathItem(pi, apiResponses)
+        newPaths[realKey] = primary
+        // Each additional request sharing a method on this path gets its own SYNTHETIC path key
+        // (`<realPath>::req::<name>`) so it renders as a distinct operation with its own try-it state. The marker
+        // is stripped back to realKey at display/URL time, so both siblings hit the same real endpoint.
+        for (const ex of extras) newPaths[realKey + PATH_DISAMBIGUATOR + ex.name] = { [ex.method]: ex.op }
+      } else {
+        newPaths[uri] = piRaw // already 3.x / unknown — leave untouched
+      }
+    }
+    d.paths = newPaths
+  }
+
+  // webhooks: v4 webhooks are request-shaped (name → Request) → 3.1 method-keyed pathItems
+  if (d.webhooks && typeof d.webhooks === 'object') {
+    const wh: Obj = {}
+    for (const [name, reqRaw] of Object.entries(d.webhooks as Obj)) {
+      const req = reqRaw as Obj
+      const method = String(req.method ?? 'get').toLowerCase()
+      wh[name] = { [method]: projectOperation(name, req, undefined, apiResponses) }
+    }
+    d.webhooks = wh
+  }
+
+  // components.responses carry v4 Response shape (contentSchema/contentType) → 3.1 Response (content[mt].schema)
+  const comp = d.components as Obj | undefined
+  if (comp && comp.responses && typeof comp.responses === 'object') {
+    const r: Obj = {}
+    for (const [k, respRaw] of Object.entries(comp.responses as Obj)) r[k] = responseEntry(respRaw as Obj)
+    comp.responses = r
+  }
+
+  // internal working model is 3.1-shaped; the DISPLAY version (4.0.0-candidate) comes from x-original-oas-version.
+  d.openapi = '3.1.0'
+  // v4-only document keys 3.1 has no slot for — drop so coerce / strict validation stays clean.
+  delete d.apiResponses
+}
