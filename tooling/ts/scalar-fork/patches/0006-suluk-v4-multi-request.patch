diff --git a/packages/workspace-store/src/helpers/strip-path-disambiguator.ts b/packages/workspace-store/src/helpers/strip-path-disambiguator.ts
new file mode 100644
index 0000000..ade861b
--- /dev/null
+++ b/packages/workspace-store/src/helpers/strip-path-disambiguator.ts
@@ -0,0 +1,21 @@
+/**
+ * SULUK v4 PATCH — multi-request-per-method support.
+ *
+ * OpenAPI v4 lets one path carry multiple named `requests` that share an HTTP method. Scalar's store keys
+ * operations by (path, method), so two such requests would collide. `projectV4ToStore` keeps the FIRST at the real
+ * path and stores each additional sibling under a SYNTHETIC path key `<realPath>::req::<requestName>` — unique, so
+ * the nav id and the try-it locationId stay distinct per sibling, while every `document.paths[key]` lookup still
+ * resolves. The marker is stripped back to the real path at the three DISPLAY/URL/ref choke points only, so the UI,
+ * clipboard, search results, and the try-it request URL never show it — and both siblings hit the same real
+ * endpoint (which is correct: they target the same URL, differing only in body/params shape).
+ *
+ * The marker is printable + real-path-illegal + slug-surviving, so even a custom generateOperationSlug keeps nav
+ * ids unique and a leaked marker degrades gracefully rather than corrupting Map keys.
+ */
+export const PATH_DISAMBIGUATOR = '::req::'
+
+/** Strip the multi-request disambiguator, returning the real path. No-op when the marker is absent. */
+export const stripPathDisambiguator = (path: string): string => {
+  const i = path.indexOf(PATH_DISAMBIGUATOR)
+  return i === -1 ? path : path.slice(0, i)
+}
