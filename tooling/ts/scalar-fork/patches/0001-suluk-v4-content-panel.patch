+/**
+ * SULUK v4 PATCH — inject native OpenAPI-v4 panels into Scalar through its own public slot API (upstream-stable;
+ * styled with Scalar's `--scalar-*` design tokens so it reads as part of Scalar). Everything goes through the
+ * `content-start` slot — empirically the one slot that mounts reliably in this build's modern reference layout
+ * (manually-passed object slots for `footer` / `content-end` do NOT surface through `v-if="$slots.footer"` /
+ * `<Content #end>` in the production Vue bundle). content-start returns a fragment (array of vnodes):
+ *   1. a facet-summary panel computed from `configuration.content` (cost coverage + access legend), and
+ *   2. a collapsed `<details>` carrying the FULL v4 superpowers inline (cost explorer · reachability · ADA ·
+ *      hardening) via an iframe to the host-supplied, role-projected `configuration['x-suluk-insights']` URL.
+ * Facets are read off ops in either the v4 (`paths[uri].requests[name]`) or downgraded 3.x shape.
+ */
+function sulukV4Slots(configuration: unknown): Record<string, () => unknown> | undefined {
+  const cfg = configuration && typeof configuration === 'object' ? (configuration as Record<string, unknown>) : {}
+  const content = cfg.content
+  const slots: Record<string, () => unknown> = {}
+  const nodes: unknown[] = []
+
+  // (1) facet-summary panel — styled as a native Scalar info card (pure --scalar-* tokens, so it adapts to EVERY
+  // Scalar theme; no hardcoded brand colors). Computed from the doc.
+  if (content && typeof content === 'object') {
+    const paths = (content as { paths?: Record<string, unknown> }).paths || {}
+    let total = 0
+    let priced = 0
+    const countOp = (op: unknown) => {
+      if (!op || typeof op !== 'object') return
+      total++
+      if ((op as Record<string, unknown>)['x-suluk-cost']) priced++
+    }
+    for (const pi of Object.values(paths)) {
+      const p = pi as Record<string, unknown>
+      if (p && p.requests) for (const r of Object.values(p.requests as Record<string, unknown>)) countOp(r)
+      else if (p) for (const m of ['get', 'put', 'post', 'patch', 'delete', 'head', 'options']) countOp(p[m])
+    }
+    if (total) {
+      const chip = (t: string) => `<span style="background:var(--scalar-background-3);border-radius:999px;padding:2px 9px">${t}</span>`
+      const html =
+        `<div style="margin:0 0 16px;padding:14px 18px;border:1px solid var(--scalar-border-color);border-radius:var(--scalar-radius-lg,12px);background:var(--scalar-background-2)">` +
+        `<div style="display:flex;align-items:center;gap:9px;flex-wrap:wrap"><b style="letter-spacing:-.01em;color:var(--scalar-color-1)">⛬ Suluk OpenAPI v4 contract</b><span style="background:var(--scalar-color-accent);color:#fff;border-radius:6px;padding:1px 8px;font-size:11px;font-weight:700">v4</span></div>` +
+        `<p style="margin:6px 0 9px;color:var(--scalar-color-2);font-size:13px">Every operation is <b>cost-metered</b> (micro-USD) and <b>access-scoped</b> — the badge on each operation shows its access + per-call cost. ${priced} of ${total} operations carry a declared cost.</p>` +
+        `<div style="display:flex;gap:7px;flex-wrap:wrap;font-size:12px;color:var(--scalar-color-2)">${chip('🌐 Public')}${chip('👤 Signed-in')}${chip('🔒 Admin')}${chip('💰 per-call cost')}</div>` +
+        `</div>`
+      nodes.push(h('div', { innerHTML: html }))
+    }
+  }
+
+  // (2) the FULL v4 superpowers, INLINE — a native-looking Scalar collapsible (themed surface + an accent left rule,
+  // not a solid accent bar) so it sits cleanly in any theme. The host passes the role-projected panels URL.
+  const ins = cfg['x-suluk-insights']
+  if (typeof ins === 'string' && ins) {
+    nodes.push(
+      h(
+        'details',
+        {
+          class: 'suluk-v4-insights',
+          style:
+            'width:100%;margin:0 0 18px;border:1px solid var(--scalar-border-color);border-left:3px solid var(--scalar-color-accent);border-radius:var(--scalar-radius-lg,12px);overflow:hidden;background:var(--scalar-background-2)',
+        },
+        [
+          h('summary', {
+            style:
+              'cursor:pointer;padding:11px 16px;font-weight:600;color:var(--scalar-color-1);background:var(--scalar-background-2)',
+            innerHTML:
+              '⚡ v4 Insights — cost explorer · reachability · ADA · hardening &nbsp;<span style="font-weight:400;color:var(--scalar-color-3)">(click to expand)</span>',
+          }),
+          h('iframe', {
+            src: ins,
+            loading: 'lazy',
+            style:
+              'display:block;width:100%;height:78vh;border:0;border-top:1px solid var(--scalar-border-color);background:var(--scalar-background-1)',
+          }),
+        ],
+      ),
+    )
+  }
+
+  if (nodes.length) slots['content-start'] = () => nodes
+
+  // (3) the v4 "View as" ROLE projector — rendered in Scalar's OWN sidebar (sidebar-start slot), styled with
+  // Scalar's design tokens so it adapts to every theme. This replaces the old bolted-on top bar. Changing it
+  // dispatches a `suluk:viewas` DOM event the host listens for (re-fetch + re-mount); the selected role is read back
+  // from `configuration['x-suluk-view']` on each mount so it survives the re-mount.
+  const views = cfg['x-suluk-views']
+  if (Array.isArray(views) && views.length) {
+    const cur = typeof cfg['x-suluk-view'] === 'string' ? (cfg['x-suluk-view'] as string) : ''
+    const opt = (value: string, label: string) =>
+      h('option', value === cur ? { value, selected: '' } : { value }, label)
+    slots['sidebar-start'] = () =>
+      h(
+        'div',
+        { class: 'suluk-v4-viewas', style: 'padding:12px;margin-top:4px;border-top:1px solid var(--scalar-border-color)' },
+        [
+          h(
+            'label',
+            {
+              for: 'suluk-viewas',
+              style:
+                'display:block;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;color:var(--scalar-color-3);margin:0 0 5px',
+            },
+            'View as',
+          ),
+          h(
+            'select',
+            {
+              id: 'suluk-viewas',
+              onChange: (e: Event) =>
+                document.dispatchEvent(new CustomEvent('suluk:viewas', { detail: (e.target as HTMLSelectElement).value })),
+              style:
+                'width:100%;font:inherit;font-size:13px;color:var(--scalar-color-1);background:var(--scalar-background-2);border:1px solid var(--scalar-border-color);border-radius:var(--scalar-radius,8px);padding:6px 8px;cursor:pointer',
+            },
+            [
+              opt('', 'As authored (full)'),
+              ...(views as Array<{ label: unknown; value: unknown }>).map((v) => opt(String(v.value), String(v.label))),
+            ],
+          ),
+        ],
+      )
+  }
+
+  return Object.keys(slots).length ? slots : undefined
+}
